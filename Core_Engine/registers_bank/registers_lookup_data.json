  "etec_framework": {
    "source": "وثيقة معايير التقويم والتصنيف والاعتماد المدرسي لمدارس التعليم العام، الإصدار الثاني 2026، هيئة تقويم التعليم والتدريب. المؤشرات 52، منها 3 خاصة بالمدارس الأهلية والعالمية، و49 للمدارس الحكومية.",
    "domains": [
      {
        "official_name": "الإدارة المدرسية",
        "display_name": "القيادة المدرسية",
        "standards": [
          {
            "code": "1-1",
            "name": "التخطيط",
            "indicators": [
              "1-1-1-1 تضع المدرسة خطة تشغيلية شاملة وفق أهداف تطويرية محددة.",
              "1-1-1-2 تتابع المدرسة تنفيذ خطتها التشغيلية، وتطورها بما يضمن تحقيق أهدافها."
            ]
          },
          {
            "code": "1-2",
            "name": "قيادة العملية التعليمية",
            "indicators": [
              "1-2-1-1 تعزز المدرسة القيم الإسلامية، والهوية الوطنية.",
              "1-2-1-2 تطبق المدرسة قيم مهنة التعليم وأخلاقياتها، وتتابع الالتزام بها.",
              "1-2-1-3 تطبق المدرسة إجراءات محددة؛ لدعم الانضباط المدرسي، وتتابع الالتزام بها.",
              "1-2-1-4 تنفذ المدرسة برامج وأنشطة تربوية داعمة للسلوك الإيجابي لدى المتعلمين، ومنهم ذوو الإعاقة والموهوبون، وتتابعها.",
              "1-2-1-5 تنفذ المدرسة برامج وأنشطة إثرائية؛ لتطوير مواهب المتعلمين، وتهيئهم للمستقبل، وتتابعها."
            ]
          },
          {
            "code": "1-3",
            "name": "المجتمع المدرسي",
            "indicators": [
              "1-3-1-1 تعزز المدرسة بناء العلاقات الإيجابية والتعاون في المجتمع المدرسي.",
              "1-3-1-2 تعزز المدرسة مشاركة الأسرة في تعلم أبنائهم، والتحضير لمستقبلهم.",
              "1-3-1-3 تعزز المدرسة الشراكة المجتمعية؛ لدعم التعلم والتأثير الإيجابي في المجتمع."
            ]
          },
          {
            "code": "1-4",
            "name": "التطوير المؤسسي",
            "indicators": [
              "1-4-1-1 توفر المدرسة كادرًا تعليميًّا مكتملًا ومؤهلًا بما يتسق مع المهام الموكلة له. (للمدارس الأهلية والعالمية)",
              "1-4-1-2 توفر المدرسة كادرًا إداريًّا مكتملًا ومؤهلًا بما يتسق مع المهام الموكلة له. (للمدارس الأهلية والعالمية)",
              "1-4-1-3 تظهر المدرسة الملاءة والاستدامة المالية. (للمدارس الأهلية والعالمية)",
              "1-4-1-4 تدعم المدرسة منسوبيها للحصول على الرخصة المهنية، وتتابعها.",
              "1-4-1-5 تدعم المدرسة التطوير المهني لمنسوبيها وفقًا لنتائج التقويم وتحليل احتياجاتهم.",
              "1-4-1-6 تطبق المدرسة التقويم الذاتيّ المبنيّ على المعايير المعتمدة من الهيئة بشكل مستمر.",
              "1-4-1-7 تنفذ المدرسة خطة التحسين بناء على نتائج التقويم المدرسي، وتتابعها."
            ]
          },
          {
            "code": "1-5",
            "name": "حقوق المتعلم وحمايته",
