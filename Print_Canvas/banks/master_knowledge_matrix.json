    "axis_5_smart_autofill": {
      "axis_id": "AX-05",
      "axis_title": "محرك التسكين الذكي متعدد المسارات",
      "principle": "التمييز التلقائي بين حالتين: (أ) إجراء أحادي بسيط للحالات الروتينية، (ب) مسار علاجي متكامل من مرحلتين للفاقد المهاري الحرج.",

      "trigger_logic": {
        "input_sources": [
          "academic_care_register.gap_type",
          "academic_care_register.severity",
          "nafes_result.percentage",
          "behavioral_cases_register.incident_classification"
        ],
        "decision_tree": [
          { "condition": "severity == 'بسيط' OR gap_type == 'معرفي'", "route": "single_step" },
          { "condition": "severity == 'متوسط' OR gap_type == 'مهاري'", "route": "multi_step" },
          { "condition": "severity == 'عميق' OR nafes_pct < 50", "route": "multi_step_critical" }
        ]
      },

      "single_step_rules": {
        "description": "للحالات الروتينية — إجراء واحد مباشر يُسكَّن تلقائياً",
        "rules": [
          {
            "rule_id": "SS-01",
            "trigger": "gap_type=معرفي AND severity=بسيط",
            "autofill": {
              "intervention_type": "دعم فردي من المعلم",
